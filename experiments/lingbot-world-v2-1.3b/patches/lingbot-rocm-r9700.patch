From 8b63d3aaaebc4082766d68e341ac7621a35e6de3 Mon Sep 17 00:00:00 2001
From: boxwrench <westsunset@gmail.com>
Date: Wed, 9 Sep 2026 14:09:16 -0700
Subject: [PATCH 2/3] vae: split Conv3d along the output temporal axis on
 gfx1201

MIOpen 3.5.1 ships no gfx1201 database. For the full-resolution VAE shapes
the only fast solver is GemmFwdRest, whose workspace scales with the output
temporal extent (11.6 GiB at out_T=3, ~15.5 GiB at out_T=4). Past that it is
silently dropped and ConvDirectNaiveConvFwd is used instead, at 0.16 TFLOP/s
against 2.6. Splitting the output temporal axis keeps each sub-convolution
below the cliff. Exact restructuring; 110.6s -> 16.4s per VAE decode.

Gated by WAN_VAE_CONV3D_TEMPORAL_SPLIT (default 2, 0 restores upstream).
---
 wan/modules/vae2_1.py | 57 +++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 57 insertions(+)

diff --git a/wan/modules/vae2_1.py b/wan/modules/vae2_1.py
index 9941da1..ca02259 100644
--- a/wan/modules/vae2_1.py
+++ b/wan/modules/vae2_1.py
@@ -1,5 +1,7 @@
 import logging
 
+import os
+
 import torch
 import torch.cuda.amp as amp
 import torch.nn as nn
@@ -13,6 +15,59 @@ __all__ = [
 CACHE_T = 2
 
 
+# --- AMD / gfx1201 workaround -------------------------------------------
+# MIOpen 3.5.1 ships no tuned database for gfx1201, so 3D convolutions are
+# resolved into the *user* FindDb at runtime. For these full-resolution VAE
+# shapes the only fast candidate is `GemmFwdRest` (im2col + GEMM), whose
+# workspace scales with the output temporal extent: ~11.6 GiB at out_T=3,
+# and ~15.5 GiB at out_T=4. Once the workspace crosses what MIOpen will
+# allocate, `GemmFwdRest` is silently dropped from the candidate list and the
+# only solver left is `ConvDirectNaiveConvFwd`, which runs at 0.16 TFLOP/s
+# against 2.6 TFLOP/s for the GEMM path.
+#
+# Measured on an R9700, FP32, input [1,96,T,482,834] with a [96,96,3,3,3]
+# kernel — the cliff is sharp and depends only on the output temporal extent,
+# not on layout, strides, spatial alignment or padding provenance:
+#
+#     out_T=1  0.096 s   2.06 TFLOP/s     out_T=4   5.036 s   0.16 TFLOP/s
+#     out_T=2  0.169 s   2.35 TFLOP/s     out_T=6   7.590 s   0.16 TFLOP/s
+#     out_T=3  0.508 s   1.17 TFLOP/s     out_T=8  10.040 s   0.16 TFLOP/s
+#
+# Splitting the convolution along the *output* temporal axis keeps every
+# sub-convolution below the cliff. This is an exact restructuring of the same
+# convolution — each output frame depends only on its own receptive field —
+# so it changes which kernel MIOpen picks, not the mathematics. Results are
+# not bit-identical to the naive kernel (different accumulation order), but
+# agree to ~2.4e-06 relative, i.e. FP32 round-off.
+#
+# Set WAN_VAE_CONV3D_TEMPORAL_SPLIT=0 to disable, or to an integer to change
+# the maximum output temporal extent per sub-convolution.
+_CONV3D_TEMPORAL_SPLIT = int(os.environ.get('WAN_VAE_CONV3D_TEMPORAL_SPLIT', '2'))
+
+
+def _conv3d_temporal_split(conv, x, max_out_t):
+    """Run `conv` on `x` in slices along the temporal axis.
+
+    Returns exactly the convolution `conv(x)` would produce. Output frame `o`
+    reads input frames `o*stride_d ... o*stride_d + (kernel_d-1)*dilation_d`,
+    so a slice producing `n` output frames needs
+    `(n-1)*stride_d + (kernel_d-1)*dilation_d + 1` input frames.
+    """
+    stride_d = conv.stride[0]
+    span = (conv.kernel_size[0] - 1) * conv.dilation[0] + 1
+    total_out = (x.shape[2] - span) // stride_d + 1
+    if total_out <= max_out_t:
+        return nn.Conv3d.forward(conv, x)
+
+    outs = []
+    for start in range(0, total_out, max_out_t):
+        n = min(max_out_t, total_out - start)
+        lo = start * stride_d
+        hi = lo + (n - 1) * stride_d + span
+        outs.append(nn.Conv3d.forward(conv, x[:, :, lo:hi]))
+    return torch.cat(outs, dim=2)
+
+
 class CausalConv3d(nn.Conv3d):
     """
     Causal 3d convolusion.
@@ -32,6 +87,8 @@ class CausalConv3d(nn.Conv3d):
             padding[4] -= cache_x.shape[2]
         x = F.pad(x, padding)
 
+        if _CONV3D_TEMPORAL_SPLIT > 0 and x.is_cuda:
+            return _conv3d_temporal_split(self, x, _CONV3D_TEMPORAL_SPLIT)
         return super().forward(x)
 
 
-- 
2.43.0


From 7cf8109194fa25ddbbe2c1b529e11f50b3534dd1 Mon Sep 17 00:00:00 2001
From: boxwrench <westsunset@gmail.com>
Date: Wed, 9 Sep 2026 15:00:59 -0700
Subject: [PATCH 3/3] vae: default temporal split to 1; release T5 after prompt
 encoding

Sweeping the split over a full 480x832 FP32 decode shows warm latency flat
across 1-3 (16.35-16.55s) while peak allocation climbs 11.33 / 15.33 / 19.19
GiB, and split=3 additionally pays a 66s cold search penalty. split=1 is the
cheapest and the only setting below the unsplit baseline's own 13.28 GiB.

Separately, umt5-xxl (~10.9 GiB bf16) was held on the GPU through VAE encode
and the DiT, which OOMs a 32 GiB card: 14.58 GiB was still allocated when VAE
encode asked for its ~12 GiB peak. The encoder is finished once the prompt is
encoded and its output is cached, so release it there unconditionally rather
than only under offload_model, which would also enable per-forward DiT
offload. Allocation at VAE encode drops 14.58 -> 4.00 GiB. The DiT stays
resident; this is sequential residency, not generic CPU offload.
---
 wan/image2video.py    | 13 +++++++++++--
 wan/modules/vae2_1.py | 22 +++++++++++++++++++---
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/wan/image2video.py b/wan/image2video.py
index 421d37f..34a82ea 100644
--- a/wan/image2video.py
+++ b/wan/image2video.py
@@ -546,8 +546,17 @@ class WanI2VCausal:
             if not self.t5_cpu:
                 self.text_encoder.model.to(self.device)
                 context = self.text_encoder([input_prompt], self.device)
-                if offload_model:
-                    self.text_encoder.model.cpu()
+                # Explicit sequential residency. umt5-xxl is ~10.9 GiB in
+                # bf16 and is semantically finished the moment the prompt is
+                # encoded: its output is cached in self._t5_cache, so a warm
+                # repeat never touches the encoder at all. Upstream only
+                # releases it under offload_model, which also enables
+                # per-forward DiT offload and empty_cache churn we do not
+                # want. On a 32 GiB card, holding it through VAE encode
+                # (~12 GiB peak) and the DiT is what pushes the pipeline into
+                # OOM, so release it here regardless.
+                self.text_encoder.model.cpu()
+                torch.cuda.empty_cache()
             else:
                 context = self.text_encoder([input_prompt], torch.device('cpu'))
                 context = [t.to(self.device) for t in context]
diff --git a/wan/modules/vae2_1.py b/wan/modules/vae2_1.py
index ca02259..89ad2e6 100644
--- a/wan/modules/vae2_1.py
+++ b/wan/modules/vae2_1.py
@@ -40,9 +40,25 @@ CACHE_T = 2
 # not bit-identical to the naive kernel (different accumulation order), but
 # agree to ~2.4e-06 relative, i.e. FP32 round-off.
 #
-# Set WAN_VAE_CONV3D_TEMPORAL_SPLIT=0 to disable, or to an integer to change
-# the maximum output temporal extent per sub-convolution.
-_CONV3D_TEMPORAL_SPLIT = int(os.environ.get('WAN_VAE_CONV3D_TEMPORAL_SPLIT', '2'))
+# The default of 1 is measured, not assumed. Sweeping the maximum output
+# temporal extent over a full 480x832 FP32 decode:
+#
+#   split  cold      warm      peak alloc  peak reserved  rel err
+#   0      110.71 s  110.82 s   13.28 GiB    19.44 GiB    (reference)
+#   1       18.64 s   16.48 s   11.33 GiB    16.49 GiB    3.64e-06
+#   2       16.91 s   16.55 s   15.33 GiB    23.76 GiB    3.64e-06
