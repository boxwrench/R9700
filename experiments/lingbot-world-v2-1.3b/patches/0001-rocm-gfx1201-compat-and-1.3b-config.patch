@@ -0,0 +1,48 @@
+import torch
+from easydict import EasyDict
+
+from .shared_config import wan_shared_cfg
+
+#------------------------ LingBot-World-V2 I2V 1.3B ------------------------#
+# Derived by inspection of the published checkpoint
+# (robbyant/lingbot-world-v2-1.3b-causal-fast, revision
+# 7e36a5f919f86cb4255cc9bfc30adb44963fbde1). Upstream ships no config for
+# this variant; shapes below come from the safetensors headers:
+#   patch_embedding.weight   [1536, 36, 1, 2, 2]  -> dim 1536, in_dim 36
+#   blocks.*.ffn.0.weight    [8960, 1536]         -> ffn_dim 8960
+#   blocks.{0..29}                                -> num_layers 30
+#   text_embedding.0.weight  [1536, 4096]         -> text_dim 4096
+# num_heads = 12 (head_dim 128) follows the Wan2.1-1.3B backbone this model
+# inherits; it is not recoverable from tensor shapes alone.
+
+i2v_1_3B = EasyDict(__name__='Config: LingBot-World-V2 I2V 1.3B')
+i2v_1_3B.update(wan_shared_cfg)
+
+# text encoder / vae are shared with the 14B release
+i2v_1_3B.t5_checkpoint = 'models_t5_umt5-xxl-enc-bf16.pth'
+i2v_1_3B.t5_tokenizer = 'google/umt5-xxl'
+
+i2v_1_3B.vae_checkpoint = 'Wan2.1_VAE.pth'
+i2v_1_3B.vae_stride = (4, 8, 8)
+
+# transformer
+i2v_1_3B.patch_size = (1, 2, 2)
+i2v_1_3B.dim = 1536
+i2v_1_3B.ffn_dim = 8960
+i2v_1_3B.freq_dim = 256
+i2v_1_3B.num_heads = 12
+i2v_1_3B.num_layers = 30
+i2v_1_3B.window_size = (-1, -1)
+i2v_1_3B.qk_norm = True
+i2v_1_3B.cross_attn_norm = True
+i2v_1_3B.eps = 1e-6
+# The 1.3B release stores its shards at the repository root rather than in
+# a `transformers/` subfolder like the 14B release.
+i2v_1_3B.causal_checkpoint = ''
+i2v_1_3B.fast_checkpoint = ''
+
+# inference — inherited from the 14B causal-fast defaults
+i2v_1_3B.sample_shift = 10.0
+i2v_1_3B.sample_steps = 70
+i2v_1_3B.boundary = 0.947
+i2v_1_3B.sample_guide_scale = (5.0, 5.0)
