diff --git a/wan/modules/attention.py b/wan/modules/attention.py
index c84d9e5..77bb5ad 100644
--- a/wan/modules/attention.py
+++ b/wan/modules/attention.py
@@ -19,6 +19,94 @@ __all__ = [
     'attention',
 ]
 
+FLASH_ATTN_AVAILABLE = FLASH_ATTN_2_AVAILABLE or FLASH_ATTN_3_AVAILABLE
+
+
+def _sdpa_attention(q, k, v, q_lens=None, k_lens=None, dropout_p=0.,
+                    softmax_scale=None, q_scale=None, causal=False,
+                    window_size=(-1, -1), dtype=torch.bfloat16):
+    """Semantically-equivalent SDPA replacement for flash_attn_varlen_func.
+
+    Inputs use the FlashAttention layout [B, L, N, C]; SDPA wants
+    [B, N, L, C], so we transpose in and out. Masks are materialised only
+    when the caller actually asks for padding / sliding-window behaviour;
+    plain causal is handed to SDPA's ``is_causal`` fast path.
+    """
+    b, lq, nq, _ = q.shape
+    lk, nk = k.shape[1], k.shape[2]
+
+    q = q.to(dtype)
+    k = k.to(dtype)
+    v = v.to(dtype)
+
+    if q_scale is not None:
+        q = q * q_scale
+
+    # [B, L, N, C] -> [B, N, L, C]
+    q = q.transpose(1, 2)
+    k = k.transpose(1, 2)
+    v = v.transpose(1, 2)
+
+    # GQA/MQA: SDPA's enable_gqa is not available on every backend, so
+    # expand K/V heads explicitly. Nq must be divisible by Nk.
+    if nq != nk:
+        assert nq % nk == 0, f'Nq={nq} not divisible by Nk={nk}'
+        rep = nq // nk
+        k = k.repeat_interleave(rep, dim=1)
+        v = v.repeat_interleave(rep, dim=1)
+
+    left, right = window_size
+    need_window = (left != -1 or right != -1)
+    need_pad = (q_lens is not None or k_lens is not None)
+
+    attn_mask = None
+    is_causal = False
+    # SDPA's is_causal aligns the mask top-left; FlashAttention aligns it
+    # bottom-right. They only agree when Lq == Lk, so take the fast path
+    # only then and build an explicit mask otherwise.
+    if not need_window and not need_pad and (not causal or lq == lk):
+        is_causal = bool(causal)
+    else:
+        # Build an additive-free boolean mask [B, 1, Lq, Lk]; True = keep.
+        device = q.device
+        qi = torch.arange(lq, device=device).view(-1, 1)
+        ki = torch.arange(lk, device=device).view(1, -1)
+        # FlashAttention aligns the *ends* of the q and k sequences.
+        offset = lk - lq
+        keep = torch.ones(lq, lk, dtype=torch.bool, device=device)
+        if causal or need_window:
+            if causal or right != -1:
+                r = 0 if (causal and right == -1) else max(right, 0)
+                keep &= (ki - (qi + offset)) <= r
+            if left != -1:
+                keep &= ((qi + offset) - ki) <= left
+        keep = keep.view(1, 1, lq, lk).expand(b, 1, lq, lk).clone()
+        if k_lens is not None:
+            kmask = (torch.arange(lk, device=device).view(1, -1)
+                     < k_lens.to(device).view(-1, 1))
+            keep &= kmask.view(b, 1, 1, lk)
+        if q_lens is not None:
+            qmask = (torch.arange(lq, device=device).view(1, -1)
+                     < q_lens.to(device).view(-1, 1))
+            # Fully-masked rows would produce NaN; keep them self-consistent
+            # by leaving their mask row untouched and zeroing the output.
+            keep |= (~qmask).view(b, 1, lq, 1)
+        attn_mask = keep
+
+    out = torch.nn.functional.scaled_dot_product_attention(
+        q, k, v, attn_mask=attn_mask, is_causal=is_causal,
+        dropout_p=dropout_p, scale=softmax_scale)
+
+    out = out.transpose(1, 2).contiguous()
+
+    if q_lens is not None:
+        qmask = (torch.arange(lq, device=out.device).view(1, -1)
+                 < q_lens.to(out.device).view(-1, 1))
+        out = out * qmask.view(b, lq, 1, 1).to(out.dtype)
+
+    return out
+
+
 
 def flash_attention(
     q,
@@ -50,11 +138,21 @@ def flash_attention(
     """
     half_dtypes = (torch.float16, torch.bfloat16)
     assert dtype in half_dtypes
-    assert q.device.type == 'cuda' and q.size(-1) <= 256
+    assert q.size(-1) <= 256
 
     # params
     b, lq, lk, out_dtype = q.size(0), q.size(1), k.size(1), q.dtype
 
+    # ROCm / AMD: no CUDA FlashAttention. Fall back to PyTorch SDPA, which
+    # runs the same math on the same [B, L, N, C] inputs. See
+    # _sdpa_attention for the mask/window/GQA equivalences.
+    if not FLASH_ATTN_AVAILABLE:
+        return _sdpa_attention(
+            q, k, v,
+            q_lens=q_lens, k_lens=k_lens, dropout_p=dropout_p,
+            softmax_scale=softmax_scale, q_scale=q_scale, causal=causal,
+            window_size=window_size, dtype=dtype).type(out_dtype)
+
     def half(x):
         return x if x.dtype in half_dtypes else x.to(dtype)
 
@@ -144,35 +242,18 @@ def attention(
     dtype=torch.bfloat16,
     fa_version=None,
 ):
-    if FLASH_ATTN_2_AVAILABLE or FLASH_ATTN_3_AVAILABLE:
-        return flash_attention(
-            q=q,
-            k=k,
-            v=v,
-            q_lens=q_lens,
-            k_lens=k_lens,
-            dropout_p=dropout_p,
-            softmax_scale=softmax_scale,
-            q_scale=q_scale,
-            causal=causal,
-            window_size=window_size,
-            deterministic=deterministic,
-            dtype=dtype,
-            version=fa_version,
-        )
-    else:
-        if q_lens is not None or k_lens is not None:
-            warnings.warn(
-                'Padding mask is disabled when using scaled_dot_product_attention. It can have a significant impact on performance.'
-            )
-        attn_mask = None
-
-        q = q.transpose(1, 2).to(dtype)
-        k = k.transpose(1, 2).to(dtype)
-        v = v.transpose(1, 2).to(dtype)
-
-        out = torch.nn.functional.scaled_dot_product_attention(
-            q, k, v, attn_mask=attn_mask, is_causal=causal, dropout_p=dropout_p)
-
-        out = out.transpose(1, 2).contiguous()
-        return out
+    return flash_attention(
+        q=q,
+        k=k,
+        v=v,
+        q_lens=q_lens,
+        k_lens=k_lens,
+        dropout_p=dropout_p,
+        softmax_scale=softmax_scale,
+        q_scale=q_scale,
+        causal=causal,
+        window_size=window_size,
+        deterministic=deterministic,
+        dtype=dtype,
+        version=fa_version,
+    )
