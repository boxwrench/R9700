# MiniMax H3 experimental dual-GPU lane. No tokens belong in this file.
HF_HOME=/ai/cache/huggingface
UV_CACHE_DIR=/ai/cache/uv
TORCH_HOME=/ai/cache/torch
TORCHINDUCTOR_CACHE_DIR=/ai/cache/torchinductor
TRITON_CACHE_DIR=/ai/cache/triton
PATH=/opt/rocm/bin:${PATH}
LD_LIBRARY_PATH=/opt/rocm/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}
MIOPEN_USER_DB_PATH=/ai/cache/miopen

COMFYUI_PATH=/ai/lab/experiments/minimax-h3/dual-gpu/runtime/ComfyUI
H3_ENV=/ai/environments/comfyui-h3
H3_OUTPUT_DIR=/ai/artifacts/runs/minimax-h3-dualgpu
H3_USER_DIR=/ai/lab/experiments/minimax-h3/dual-gpu/user
H3_MODEL_PATH_CONFIG=/ai/comfyui/extra_model_paths.yaml

# Preserve the R9700 as logical cuda:0 and expose the 7900 XT as cuda:1.
HIP_VISIBLE_DEVICES=1,0

TORCH_ROCM_AOTRITON_ENABLE_EXPERIMENTAL=1
MIOPEN_FIND_MODE=FAST
H3_FLEX_ATTENTION=off
